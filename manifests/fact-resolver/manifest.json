{
  "task_id": "fact-resolver",
  "type": "agent",
  "description": "Matches newly extracted facts to semantically equivalent stored facts",
  "model": "gpt-4.1-mini",
  "temperature": 0,
  "schema": "schema.py",
  "parameters": {
    "comparisons_json": {
      "required": true,
      "default": "[]"
    }
  },
  "prompts": [
    {
      "template": "system.md"
    },
    {
      "template": "context.md"
    }
  ],
  "timeout": 45
}
